{
  "uid": "dropify-order",
  "title": "Order",
  "tags": ["dropify"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "주문 TPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(dropify_order_placed_total{application=\"dropify\"}[1m])",
          "legendFormat": "주문 TPS"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "주문 API 5xx 에러율",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(http_server_requests_seconds_count{application=\"dropify\", uri=~\"/api/orders.*\", outcome=\"SERVER_ERROR\"}[5m]) / rate(http_server_requests_seconds_count{application=\"dropify\", uri=~\"/api/orders.*\"}[5m])",
          "legendFormat": "에러율"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1 }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "분산 락 획득 실패율",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(dropify_lock_acquire_failure_total{application=\"dropify\"}[5m]) / rate(dropify_lock_acquire_total{application=\"dropify\"}[5m])",
          "legendFormat": "락 실패율"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1 }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Toss 결제 API 응답시간 (P95 / P99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(dropify_toss_api_duration_seconds_bucket{application=\"dropify\"}[5m]))",
          "legendFormat": "P95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, rate(dropify_toss_api_duration_seconds_bucket{application=\"dropify\"}[5m]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ]
}
